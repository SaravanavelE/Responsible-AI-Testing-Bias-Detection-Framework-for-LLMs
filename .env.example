# Application
APP_NAME=ULockAI Shield
APP_ENV=development
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://ulockai:ulockai_secret@127.0.0.1:5433/ulockai_shield
DATABASE_URL_SYNC=postgresql://ulockai:ulockai_secret@127.0.0.1:5433/ulockai_shield

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ulockai_minio
S3_SECRET_KEY=ulockai_minio_secret
S3_BUCKET=ulockai-reports
S3_REGION=us-east-1
S3_USE_SSL=false

# Encryption (Fernet key for API keys)
ENCRYPTION_KEY=generate-with-python-cryptography-fernet-generate-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Dynamic probe LLM (optional - uses tenant connection if unset)
DYNAMIC_PROBE_PROVIDER=openai
DYNAMIC_PROBE_MODEL=gpt-4o-mini
